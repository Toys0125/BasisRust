{
  "date": "2026-10-05",
  "server_revision": "09cf74f6168a02d3a8355dcfbed389fcd530ddb6",
  "cause": "Unbounded allocated event tasks waiting for a worker semaphore. Voice fanout occupies workers; avatar deltas share the dispatcher and dominate waiting memory in the 1,000-user run.",
  "evidence": [
    "Task counts and process memory have R-squared greater than 0.9999 in both original-dispatch reproductions.",
    "The 1,000-user queue peak contains 506,072 avatar delta tasks and 59,126 voice tasks.",
    "Queues drain to zero and process memory returns to 29-42 MiB after client exit and idle reclamation.",
    "The matched bounded-admission experiment caps allocated tasks at 64 and marked-window working set at 198 MiB, versus 3,222 MiB with original dispatch.",
    "The bounded-admission probe saturates the existing 262,144-event ingress queue, so it is a causal experiment rather than a complete voice-capacity fix."
  ],
  "raw_capture": "captures/voice-memory-investigation-20261005",
  "diagnostics": {
    "counter_interval_seconds": 1,
    "process_interval_seconds": 2,
    "native_allocation_stack_profiler_used": false,
    "task_count_cross_check": "Tokio RuntimeMetrics num_alive_tasks",
    "causal_probe_removed_from_normal_source": true
  },
  "validation": {
    "focused_tests_passed": 3,
    "locked_release_build_passed": true,
    "rust_formatting_passed": true,
    "python_parsing_passed": true,
    "git_diff_check_passed": true,
    "outcome_assertions_passed": true
  },
  "limitations": [
    "One local Windows loopback run per condition; server and headless load generator share the host.",
    "Task/frame accounting and a causal probe identify the retained work; no native allocation-stack trace was collected.",
    "Queue and memory maxima may occur at different times; regression joins samples by timestamp interpolation.",
    "The 250-user first diagnostic version did not measure delta or ingress queue counts.",
    "The bounded probe changes where unreliable traffic is queued/dropped; it is not an equal-work efficiency claim.",
    "The investigation confirms the dominant growth mechanism in these runs, not the absence of all unrelated leaks."
  ],
